{
  "name": "dispose-me-cf",
  "version": "0.1.0",
  "private": true,
  "description": "Dispose Me - Cloudflare: self-hosted disposable email on Workers, Email Routing, D1, and R2.",
  "author": "Kamil Dybicz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kdybicz/dispose-me-cf.git"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "yarn": ">=4.18.1"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./service/assets/css/styles.css -o ./service/assets/css/output.css --minify",
    "build": "yarn build:css && node cloudflare/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check:worker": "yarn typecheck && wrangler deploy --dry-run",
    "dev": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev --test-scheduled",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "node cloudflare/deployment.mjs deploy",
    "config": "node cloudflare/deployment.mjs configure",
    "infra": "node cloudflare/deployment.mjs infra",
    "state:bootstrap": "node cloudflare/terraform-state.mjs",
    "check:infra": "node cloudflare/terraform-check.mjs",
    "test:deployment": "node --test cloudflare/deployment.test.mjs cloudflare/terraform-state.test.mjs",
    "test:unit": "tsx --test test/*.test.ts",
    "test:integration": "yarn build && node cloudflare/smoke.mjs",
    "test:browser": "yarn build && node cloudflare/smoke.mjs --browser",
    "test": "yarn test:unit && yarn test:deployment && yarn test:integration",
    "lint": "biome check service cloudflare test",
    "format": "biome check --write service cloudflare test",
    "audit": "yarn npm audit --recursive --severity high"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "feed": "^6.0.0",
    "helmet": "^8.3.0",
    "postal-mime": "^4.2.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cloudflare/workers-types": "^5.20261101.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/sanitize-html": "^2.16.2",
    "aws4fetch": "^1.0.20",
    "ejs": "^7.0.2",
    "glob": "^14.0.3",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "wrangler": "^4.156.0"
  },
  "packageManager": "yarn@4.18.1"
}
